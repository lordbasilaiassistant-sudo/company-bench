{
  "name": "company-bench",
  "version": "3.0.0",
  "description": "A 50-chair diagnostic benchmark for model judgment on workplace scenarios, with deterministic scoring, auditable outputs, and an optional executed-code track. No LLM judge.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test bench/integrity.test.mjs bench/runner.test.mjs bench/coding/integrity.test.mjs",
    "selftest": "node bench/selftest.mjs",
    "list": "node bench/run.mjs --list",
    "take": "node bench/take.mjs",
    "grade": "node bench/grade.mjs",
    "bench": "node bench/run.mjs",
    "report": "node bench/report.mjs"
  },
  "keywords": ["llm", "benchmark", "agent", "evaluation", "eval", "ai-agents", "prompt-injection", "agent-safety", "llm-eval", "autonomy"],
  "repository": { "type": "git", "url": "https://github.com/lordbasilaiassistant-sudo/company-bench.git" },
  "homepage": "https://lordbasilaiassistant-sudo.github.io/company-bench/",
  "files": ["bench", "models.json", "PROMPT.md", "skills"]
}
